# ==============================================================================
# La Table Française - Email Verification & One-Click AI Approval Configuration
# ==============================================================================

# 1. Your Gmail address sending the emails
SMTP_EMAIL=your-email@gmail.com

# 2. 16-character Google App Password (create at: https://myaccount.google.com/apppasswords)
SMTP_APP_PASSWORD=abcd efgh ijkl mnop

# 3. Where you want to receive the recipe preview emails
RECIPIENT_EMAIL=your-personal-email@gmail.com

# 4. Webhook Approval Listener Settings
APPROVAL_SERVER_PORT=3005

# 5. Base URL for the one-click [Approve] / [Reject] buttons in your email
# - On desktop/laptop: http://localhost:3005
# - On mobile/phone: your Cloudflare Tunnel or public URL
APPROVAL_BASE_URL=http://localhost:3005
